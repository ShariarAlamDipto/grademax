# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# debug/utility scripts that should not be in version control
check_paperlords*.js
check_pages.js
scripts/check-r2.js
config/google-service-account.json
config/*.json

# build-time papers-index snapshot (regenerated every build by prebuild)
/src/generated/

# Python
__pycache__/
*.pyc

# Workbook segment PDFs (~103 MB). Deliberately not tracked, unlike the older
# data/processed corpus which predates the R2 migration:
#   - the app serves them from R2 (workbook/fpm/...), never from the repo
#   - they are deterministically regenerable:
#       python scripts/build_fpm_workbook_segments.py --execute
# The JSON alongside them IS tracked — it is the classification work product and
# costs API calls to rebuild.
/data/workbook/*/
