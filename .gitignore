# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# debug/utility scripts that should not be in version control
check_paperlords*.js
check_pages.js
scripts/check-r2.js
config/google-service-account.json
config/*.json

# build-time papers-index snapshot (regenerated every build by prebuild)
/src/generated/

# Python
__pycache__/
*.pyc

# Workbook segment PDFs (~103 MB). Deliberately not tracked:
#   - the app serves them from R2 (workbook/fpm/...), never from the repo
#   - they are deterministically regenerable:
#       python scripts/build_fpm_workbook_segments.py --execute
# The JSON alongside them IS tracked — it is the classification work product and
# costs API calls to rebuild.
/data/workbook/*/

# Harvested third-party paper links: local working data, not for publication.
data/manifest/paperlords_*

# ── Local data that must never reach this public repo ─────────────────────
# Personal data: the Supabase export holds every user's email and profile
# (auth/users.json, public/profiles.jsonl).
/data/supabase-export/
# Database row backups taken before live writes.
/data/backups/
# Raw Pearson/Cambridge paper archives, built books and quarantined papers:
# multi-GB, copyrighted, and served from R2 rather than the repo.
/data/Ultimate Final IGCSE/
/data/Ultimate Final IAL/
/data/yearwise_all/
/data/quarantine/
/data/staging/
/data/ict_data_files/
/data/raw/
# Segment PDFs and their JSON: R2 serves them and the pipeline reads the local
# copy. Untracked on 20 Oct 2026 (~980 MB); older commits still hold them.
/data/processed/
# Admin-only predicted papers and ingest logs with local machine paths.
/data/predictions/
/data/cambridge_ingest/
# Finished FAQ renders are a product; their JSON build data is tracked.
/data/faq/**/*.pdf
/data/faq/**/*.html

# data/analysis is a 17 GB scratch area (cuts, renders, logs, caches). Track only
# the hand-made chapter/topic decisions, which cost reading time to rebuild.
/data/analysis/*
!/data/analysis/live_rebuild/
/data/analysis/live_rebuild/*
!/data/analysis/live_rebuild/*/
/data/analysis/live_rebuild/*/*
!/data/analysis/live_rebuild/*/topic_reads.json
!/data/analysis/live_rebuild/*/topics_new.json
!/data/analysis/live_rebuild/*/manual_review.json

# Generated output and local workspace.
/output/
/tmp/
/training-data/
/.vscode/
/.r2setup.ts
